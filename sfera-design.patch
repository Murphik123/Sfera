+:root{
+  /* Background palette */
+  --bg-1: #06111d;
+  --bg-2: #0b2035;
+  --bg-3: #102b45;
+
+  /* Accent colors */
+  --primary: #00d4ff; /* neon cyan */
+  --secondary: #1f6bff; /* deep blue */
+  --accent: #00ffa3; /* emerald mint */
+
+  /* Text */
+  --text: #ffffff;
+  --text-ice: #dbe9ff;
+  --muted: #9fb5c8;
+
+  /* Glassmorphism */
+  --glass-bg: rgba(255,255,255,0.06);
+  --glass-bg-strong: rgba(255,255,255,0.12);
+  --glass-border: rgba(255,255,255,0.18);
+  --glass-blur: 18px;
+
+  /* Particles */
+  --dot-size: 4px;
+  --dot-glow: 12px;
+  --particle-min-duration: 6s;
+  --particle-max-duration: 18s;
+
+  /* Sphere core */
+  --ring-radius: 120px;
+  --core-size: 48px;
+}
