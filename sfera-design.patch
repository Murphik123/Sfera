+// initConstellation: лёгкая canvas-констелляция с точками и линиями
+export default function initConstellation(canvas){
+  if(!canvas) return;
+  const ctx = canvas.getContext('2d');
+  let width, height, nodes;
+  function resize(){ width = canvas.width = innerWidth; height = canvas.height = innerHeight; initNodes(); }
+  function initNodes(){
+    nodes = [];
+    const count = Math.max(6, Math.floor((width*height)/90000));
+    for(let i=0;i<count;i++){
+      nodes.push({x: Math.random()*width, y: Math.random()*height, vx:(Math.random()-0.5)*0.3, vy:(Math.random()-0.5)*0.3});
+    }
+  }
+  function step(){
+    ctx.clearRect(0,0,width,height);
+    for(let i=0;i<nodes.length;i++){
+      const n = nodes[i];
+      n.x += n.vx; n.y += n.vy;
+      if(n.x<0||n.x>width) n.vx *= -1;
+      if(n.y<0||n.y>height) n.vy *= -1;
+      ctx.fillStyle = 'rgba(0,212,255,0.9)';
+      ctx.beginPath(); ctx.arc(n.x,n.y,1.6,0,Math.PI*2); ctx.fill();
+      for(let j=i+1;j<nodes.length;j++){
+        const m = nodes[j];
+        const dx = n.x-m.x, dy = n.y-m.y;
+        const d2 = dx*dx+dy*dy;
+        if(d2<9000){
+          ctx.strokeStyle = 'rgba(0,212,255,' + (0.12 - d2/9000*0.12) + ')';
+          ctx.lineWidth = 0.6;
+          ctx.beginPath(); ctx.moveTo(n.x,n.y); ctx.lineTo(m.x,m.y); ctx.stroke();
+        }
+      }
+    }
+    requestAnimationFrame(step);
+  }
+  addEventListener('resize', resize);
+  resize();
+  step();
+}
