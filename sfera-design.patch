+@import './_design-vars.css';
+
+.particles {
+  position: fixed;
+  inset: 0;
+  pointer-events: none;
+  z-index: 0;
+}
+
+.particles .dot {
+  position: absolute;
+  width: var(--dot-size);
+  height: var(--dot-size);
+  border-radius: 50%;
+  background: var(--primary);
+  box-shadow: 0 0 var(--dot-glow) var(--primary);
+  opacity: 0.85;
+  transform: translate3d(0,0,0);
+  animation-name: floatUp;
+  animation-timing-function: ease-in-out;
+  animation-iteration-count: infinite;
+  will-change: transform, opacity;
+}
+
+@keyframes floatUp {
+  0% { transform: translateY(30vh) scale(0.9); opacity: 0.6; }
+  50% { transform: translateY(10vh) scale(1.05); opacity: 1; }
+  100% { transform: translateY(-10vh) scale(0.95); opacity: 0.6; }
+}
