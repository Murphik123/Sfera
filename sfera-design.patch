+/* spotlight.js
+   Отслеживает курсор и обновляет CSS-переменные --spot-x и --spot-y для элементов .spotlight
+*/
+(function(){
+  try {
+    const els = [];
+    function refreshEls(){
+      els.length = 0;
+      document.querySelectorAll('.spotlight').forEach(e => els.push(e));
+    }
+    function onMove(e){
+      const x = e.clientX;
+      const y = e.clientY;
+      els.forEach(el=>{
+        const rect = el.getBoundingClientRect();
+        const rx = ((x - rect.left)/rect.width)*100;
+        const ry = ((y - rect.top)/rect.height)*100;
+        el.style.setProperty('--spot-x', rx + '%');
+        el.style.setProperty('--spot-y', ry + '%');
+      });
+    }
+    document.addEventListener('DOMContentLoaded', refreshEls);
+    document.addEventListener('DOMContentLoaded', ()=> addEventListener('pointermove', onMove));
+    // observe DOM changes to catch dynamically added spotlight elements
+    const obs = new MutationObserver(refreshEls);
+    obs.observe(document.body, {childList:true, subtree:true});
+  } catch(e) {
+    console.error('spotlight init error', e);
+  }
+})();
