+@import './_design-vars.css';
+
+.sphere-wrap { position: relative; display:inline-flex; align-items:center; justify-content:center; }
+.rings { transform-origin:center; animation: spinRing 18s linear infinite; z-index:1; }
+.ring { opacity: 0.95; filter: drop-shadow(0 0 8px rgba(0,212,255,0.18)); transition: transform .6s ease; }
+.ring:hover { transform: rotate(45deg); }
+
+@keyframes spinRing { from{ transform: rotate(0deg);} to{ transform: rotate(360deg);} }
+
+.core {
+  width: var(--core-size);
+  height: var(--core-size);
+  border-radius: 50%;
+  background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.95), rgba(0,212,255,0.12) 30%, rgba(0,0,0,0) 60%);
+  box-shadow: 0 0 28px rgba(0,212,255,0.28), inset 0 0 12px rgba(255,255,255,0.12);
+  animation: corePulse 2.6s ease-in-out infinite;
+  z-index:2;
+}
+@keyframes corePulse {
+  0% { transform: scale(1); opacity: 1; }
+  50% { transform: scale(1.12); opacity: 0.9; }
+  100% { transform: scale(1); opacity: 1; }
+}
