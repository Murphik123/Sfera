+/* particles-init.js
+   Создаёт набор плавающих точек и добавляет их в body.
+   Лёгкая, без зависимостей, инициализация.
+*/
+(function(){
+  try {
+    const root = document.documentElement;
+    const container = document.createElement('div');
+    container.className = 'particles';
+    const count = 24;
+    const minDur = parseFloat(getComputedStyle(root).getPropertyValue('--particle-min-duration')) || 6;
+    const maxDur = parseFloat(getComputedStyle(root).getPropertyValue('--particle-max-duration')) || 18;
+    for(let i=0;i<count;i++){
+      const d = document.createElement('div');
+      d.className = 'dot';
+      const left = Math.random()*100;
+      const top = 60 + Math.random()*40; // старт снизу
+      const dur = (Math.random()*(maxDur - minDur) + minDur).toFixed(2);
+      d.style.left = left + '%';
+      d.style.top = top + 'vh';
+      d.style.animationDuration = dur + 's';
+      d.style.animationDelay = (Math.random()*-18).toFixed(2) + 's';
+      container.appendChild(d);
+    }
+    document.addEventListener('DOMContentLoaded', ()=> document.body.appendChild(container));
+  } catch(e) {
+    console.error('particles-init error', e);
+  }
+})();
