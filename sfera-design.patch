+@import './_design-vars.css';
+
+/* Base page styles */
+html,body{
+  height:100%;
+}
+body {
+  margin:0;
+  min-height:100%;
+  background: linear-gradient(180deg, var(--bg-1), var(--bg-2), var(--bg-3));
+  color: var(--text);
+  font-family: 'Inter', system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
+  -webkit-font-smoothing: antialiased;
+  -moz-osx-font-smoothing: grayscale;
+}
+
+/* Glassmorphism utility */
+.glass {
+  background: var(--glass-bg);
+  border: 1px solid var(--glass-border);
+  border-radius: 16px;
+  backdrop-filter: blur(var(--glass-blur));
+  -webkit-backdrop-filter: blur(var(--glass-blur));
+  box-shadow: 0 8px 30px rgba(2,6,23,0.6);
+  color: inherit;
+}
+.glass-strong {
+  background: var(--glass-bg-strong);
+  border-radius: 20px;
+  border: 1px solid rgba(255,255,255,0.22);
+}
+
+/* Gradient utility */
+.bg-accent {
+  background-image: linear-gradient(135deg, var(--primary), var(--secondary));
+  color: white;
+}
+
+/* Hover lift */
+.hover-lift {
+  transition: transform .28s cubic-bezier(.2,.9,.2,1), box-shadow .28s;
+}
+.hover-lift:hover {
+  transform: translateY(-8px);
+  box-shadow: 0 18px 40px rgba(0,0,0,0.45), 0 0 24px rgba(0,212,255,0.08);
+}
+
+/* Spotlight (radial gradient following cursor) */
+.spotlight {
+  position: relative;
+  overflow: hidden;
+}
+.spotlight::after {
+  content: "";
+  position: absolute;
+  left: var(--spot-x, 50%);
+  top: var(--spot-y, 50%);
+  width: 420px;
+  height: 420px;
+  transform: translate(-50%, -50%);
+  pointer-events: none;
+  background: radial-gradient(circle at center, rgba(0,212,255,0.12), transparent 40%);
+  mix-blend-mode: screen;
+  transition: left .12s linear, top .12s linear;
+}
+
+/* Reduce motion preference */
+@media (prefers-reduced-motion: reduce) {
+  .hover-lift { transition: none; transform: none !important; }
+  .rings, .core { animation: none !important; }
+  .particles .dot { animation: none !important; opacity: 0.7; }
+}
