@@ -0,0 +1,36 @@
+Design system for SFERA (Glassmorphism)
+
+Files added:
+- css/_design-vars.css         — CSS custom properties (colors, sizes, durations)
+- css/glass-utils.css          — glassmorphism utilities, spotlight, hover-lift
+- css/particles.css            — styles for floating neon particles
+- css/sphere.css               — styles for rings and core
+- js/particles-init.js         — creates floating particles on page load
+- js/constellation.js          — module for canvas constellation
+- js/spotlight.js              — spotlight cursor tracking
+- components/sphere.html       — SVG rings + core component
+
+How to enable:
+1. Ensure your layout includes the CSS links in the <head> and the scripts before </body>.
+   Example head includes:
+     <link rel="stylesheet" href="/css/_design-vars.css">
+     <link rel="stylesheet" href="/css/glass-utils.css">
+     <link rel="stylesheet" href="/css/particles.css">
+     <link rel="stylesheet" href="/css/sphere.css">
+
+   Example scripts before </body>:
+     <canvas id="constellation" style="position:fixed; inset:0; z-index:0; pointer-events:none;"></canvas>
+     <script src="/js/particles-init.js" defer></script>
+     <script src="/js/spotlight.js" defer></script>
+     <script type="module" defer>
+       import initConstellation from '/js/constellation.js';
+       document.addEventListener('DOMContentLoaded', ()=> {
+         const c = document.getElementById('constellation');
+         if(c) initConstellation(c);
+       });
+     </script>
+
+Performance notes:
+- Limit particle count on mobile.
+- Respect prefers-reduced-motion for accessibility.
