PORT=5000
MONGODB_URI=mongodb://localhost:27017/sfera
REDIS_URL=redis://localhost:6379

# Обязательно: длинная случайная строка (например, `openssl rand -hex 32`).
# Сервер не запустится без этой переменной.
JWT_SECRET=

# Список разрешённых origin через запятую (например, https://sfera.tm,https://app.sfera.tm).
# Пустое значение = разрешены только запросы с того же origin.
CORS_ORIGINS=

QDRANT_URL=
QDRANT_API_KEY=
RESEND_API_KEY=
